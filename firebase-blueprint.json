{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role management",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID matching auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "User access role",
          "enum": ["user", "admin"]
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when user profile was created"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Customer callback and evaluation inquiry",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Customer full name",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Customer contact phone number",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Enquiry processing status",
          "enum": ["pending", "contacted", "closed"]
        },
        "message": {
          "type": "string",
          "description": "Customer query or notes",
          "maxLength": 1000
        },
        "location": {
          "type": "string",
          "description": "Selected location or branch",
          "maxLength": 150
        },
        "service": {
          "type": "string",
          "description": "Selected service requested",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        }
      },
      "required": ["name", "phone", "status", "createdAt"]
    },
    "WhatsAppTemplate": {
      "title": "WhatsAppTemplate",
      "description": "Pre-formatted WhatsApp message templates for valuation stages",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Template title or headline",
          "maxLength": 120
        },
        "stage": {
          "type": "string",
          "description": "Valuation stage or category",
          "enum": ["Appointment", "Pledged Gold", "XRF Testing", "Final Offer", "Payout", "General"]
        },
        "content": {
          "type": "string",
          "description": "Template message body with dynamic placeholders",
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["title", "stage", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with authentication mapping and roles"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Stores customer inquiries and callback requests"
    },
    "/whatsapp_templates/{templateId}": {
      "schema": "WhatsAppTemplate",
      "description": "Stores admin-managed WhatsApp message templates"
    }
  }
}
